# MongoDB connection string. The database name must be in the path.
# Local (npm run db:dev): mongodb://127.0.0.1:27017/call-campaign-dev
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/call-campaign?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/call-campaign-dev

# Signs session cookies. Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
