# PostgreSQL connection string.
# Local (npm run db:dev):  postgres://postgres@127.0.0.1:5432/postgres
# Supabase (Project → Connect → Transaction pooler, port 6543):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
# Local PGlite needs a pool of 1. On Supabase leave this out (defaults to 3).
DATABASE_POOL_MAX=1

# Signs session cookies. Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
